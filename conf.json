{
  "server": {
    "port": 8080,
    "listen": "0.0.0.0"
  },
  "redis": {
    "host": "localhost",
    "port": 6379
  },
  "loadbalancer": {
    "services": [
      {
        "rateLimiter": {
          "limit": 100,
          "window": 60
        },
        "group": "user-service",
        "location": "/user",
        "hosts": [
          "http://localhost:3000/user",
          "http://localhost:3001/user",
          "http://localhost:3002/user",
          "http://localhost:3003/user"
        ]
      },
      {
        "group": "order-service",
        "location": "/order",
        "hosts": [
          "http://localhost:3000/order",
          "http://localhost:3001/order",
          "http://localhost:3002/order",
          "http://localhost:3003/order"
        ]
      }
    ]
  }
}
